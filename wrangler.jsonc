{
  "name": "voter98-frontend-cloudflare",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "VITE_API_BASE_URL": "https://poll-backend.swiftgi.uk/api"
  },
  "deploy": {
    "command": "npx wrangler deploy"
  }
}